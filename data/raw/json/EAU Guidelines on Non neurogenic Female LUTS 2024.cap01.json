ll}], "year": 2024, "version": null, "language": "en", "audience": "clinician", "specialty": "Urology", "jurisdiction": null, "source_pages": null, "quality_flags": [], "summary": "This guideline provides evidence-based guidance for assessing and treating lower urinary tract symptoms in women without neurological disease. It addresses storage, voiding and post-micturition symptoms through clinical sections on overactive bladder, urinary incontinence, underactive bladder, bladder outlet obstruction, nocturia, pelvic organ prolapse, urinary fistula and urethral diverticulum. It is intended primarily for urologists and may also be used by other healthcare professionals; symptoms caused by neurological disease and symptoms in children are outside its scope.", "extraction_date": "2026-10-09"}, "scope": {"conditions_covered": ["Overactive bladder", "Stress urinary incontinence", "Mixed urinary incontinence", "Underactive bladder", "Detrusor underactivity", "Bladder outlet obstruction", "Anatomic bladder outlet obstruction", "Functional bladder outlet obstruction", "Nocturia", "Pelvic organ prolapse and lower urinary tract symptoms", "Urinary fistula", "Obstetric fistula", "Iatrogenic fistula", "Vesico-vaginal fistula", "Radiation fistula", "Ureteric fistula", "Urethro-vaginal fistula", "Urethral diverticulum"], "care_settings": [], "target_population": ["Women with non-neurogenic lower urinary tract symptoms"], "therapeutic_areas": ["Conservative management", "Pharmacological management", "Surgical management", "Urinary containment", "Lifestyle interventions", "Behavioural and physical therapies", "Bladder training", "Pelvic floor muscle training", "Pelvic floor muscle relaxation training with biofeedback", "Electrical stimulation", "Posterior tibial nerve stimulation", "Acupuncture", "Electroacupuncture", "Electromagnetic stimulation", "Anticholinergic drugs", "Beta-3 agonists", "Oestrogens", "Duloxetine", "Desmopressin", "Diuretic treatment", "Bladder wall injection of botulinum toxin A", "Sacral nerve stimulation", "Laser treatment", "Cystoplasty/urinary diversion", "Colposuspension surgery", "Autologous sling", "Urethral bulking agents", "Mid-urethral slings", "Clean intermittent self-catheterisation", "Indwelling catheter", "Pelvic organ prolapse surgery", "Vaginal pessary", "Urinary catheterisation", "Management of fistula", "Surgical treatment of urethral diverticulum"]}, "treatment_pathways": [], "safety": {"toxicities": [], "prophylaxis": [], "infection_management": []}, "recommendations": [], "artifacts": [{"artifact_id": "art_01", "type": "table", "title": null, "source_heading": "TABLE OF CONTENTS PAGE", "data": {"columns": [], "rows": [["1. INTRODUCTION", "10"]]}, "description": null, "summary": "The table locates the introduction on page 10.", "clinical_relevance": null}], "special_populations": [{"population": "Elderly patients", "considerations": "The guideline addresses cognition and anticholinergic burden when considering anticholinergics and beta-3 agonists for this group.", "treatment_modifications": null, "conditions": ["Overactive bladder"], "condition_refs": ["cond_02"]}, {"population": "Childbearing women", "considerations": "The guideline considers the efficacy of pelvic floor muscle training in this group.", "treatment_modifications": null, "conditions": ["Stress urinary incontinence"], "condition_refs": ["cond_03"]}, {"population": "Elderly women", "considerations": "The guideline considers pelvic floor muscle training and surgery for this group.", "treatment_modifications": null, "conditions": ["Stress urinary incontinence"], "condition_refs": ["cond_03"]}, {"population": "Obese women", "considerations": "The guideline addresses weight loss and surgical treatment in this group.", "treatment_modifications": null, "conditions": ["Stress urinary incontinence"], "condition_refs": ["cond_03"]}, {"population": "Women with pelvic organ prolapse and stress urinary incontinence", "considerations": "The guideline considers vaginal and abdominal prolapse surgery for women with both conditions.", "treatment_modifications": null, "conditions": ["Pelvic organ prolapse and lower urinary tract symptoms", "Stress urinary incontinence"], "condition_refs": ["cond_09", "cond_03"]}, {"population": "Continent women with pelvic organ prolapse", "considerations": "The guideline considers vaginal and abdominal prolapse surgery in this group.", "treatment_modifications": null, "conditions": ["Pelvic organ prolapse and lower urinary tract symptoms"], "condition_refs": ["cond_09"]}, {"population": "Women with pelvic organ prolapse and occult stress urinary incontinence", "considerations": "The guideline considers vaginal prolapse surgery in this group.", "treatment_modifications": null, "conditions": ["Pelvic organ prolapse and lower urinary tract symptoms", "Stress urinary incontinence"], "condition_refs": ["cond_09", "cond_03"]}], "keywords": [{"from_document": []}], "document_sections": [{"heading": "1. INTRODUCTION", "content": "Lower urinary tract symptoms (LUTS) include storage, voiding and post-micturition symptoms. Storage symptoms comprise frequency, urgency, nocturia and urinary incontinence (UI), including stress UI [SUI], urgency UI [UUI] and mixed UI [MUI]. Voiding symptoms comprise difficulty starting urination, interrupted or slow flow, straining, a split or spraying stream, and dribbling at the end of urination. Post-micturition symptoms include dribbling after voiding and a sensation that the bladder has not emptied fully. LUTS are often grouped into clinical entities such as overactive bladder (OAB), underactive bladder (UAB), UI, nocturia, dysfunctional voiding and genitourinary fistulae. LUTS are common among women and can cause substantial distress, embarrassment and costs for individuals and society. Prevalence estimates depend on the definitions and populations studied, but the associated human and economic burden is widely recognised."}, {"heading": "1.1 Aim and objectives", "content": "These guidelines offer practical, evidence-based guidance for evaluating and treating clinical problems associated with female LUTS. They are intended primarily for urologists, although other professional groups may use them. They address common clinical problems, summarise relevant evidence and provide guidance where high-quality evidence is scarce or absent. Their emphasis is clinical assessment and treatment rather than a detailed review of causation, basic science, epidemiology or psychology. Women whose LUTS result from neurological disease and children with LUTS fall outside their scope. The scope extends beyond UI to non-neurogenic female LUTS, including functional urological conditions that do not necessarily involve UI. Differences in anatomy and physiology mean that the prevalence, pathophysiology, diagnosis and management of LUTS differ substantially between women and men."}], "therapies_index": [{"name": "Addressing associated medical co-morbidities", "type": "other", "components": [], "mechanism": null, "approved_indications": [], "administration": null, "key_toxicities": [], "monitoring": [], "pathway_refs": []}, {"name": "Adjustment of other medication", "type": "other", "components": [], "mechanism": null, "approved_indications": [], "administration": null, "key_toxicities": [], "monitoring": [], "pathway_refs": []}, {"name": "Urinary containment", "type": "other", "components": [], "mechanism": null, "approved_indications": [], "administration": null, "key_toxicities": [], "monitoring": [], "pathway_refs": []}, {"name": "Caffeine intake", "type": "other", "components": [], "mechanism": null, "approved_indications": [], "administration": null, "key_toxicities": [], "monitoring": [], "pathway_refs": []}, {"name": "Fluid intake", "type": "other", "components": [], "mechanism": null, "approved_indications": [], "administration": null, "key_toxicities": [], "monitoring": [], "pathway_refs": []}, {"name": "Weight loss", "type": "other", 